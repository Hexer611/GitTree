<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitTree.App.ViewModels"
        xmlns:core="using:GitTree.Core"
        x:Class="GitTree.App.Views.CheckoutCommitWindow"
        x:DataType="vm:CheckoutCommitViewModel"
        Title="Checkout..."
        Width="520"
        SizeToContent="Height"
        MinWidth="440"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top"
                   Text="Checkout a local or remote branch at this commit, or detach HEAD if none point here."
                   FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="8"
                    HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}" />
            <Button Classes="accent" Content="Checkout" Command="{Binding ConfirmCommand}" />
        </StackPanel>

        <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="10">
            <TextBlock Text="Commit:" Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding CommitLabel}" FontWeight="SemiBold"
                       TextWrapping="Wrap" VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Text="Branch:" Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center" />
            <ComboBox Grid.Row="1" Grid.Column="1"
                      ItemsSource="{Binding Choices}"
                      SelectedItem="{Binding SelectedChoice}"
                      HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="core:CheckoutChoice">
                        <TextBlock Text="{Binding Label}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
    </DockPanel>
</Window>
