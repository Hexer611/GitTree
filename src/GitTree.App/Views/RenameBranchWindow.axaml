<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitTree.App.ViewModels"
        x:Class="GitTree.App.Views.RenameBranchWindow"
        x:DataType="vm:RenameBranchViewModel"
        Icon="/Assets/gittree.ico"
        Title="Rename Branch"
        Width="480"
        SizeToContent="Height"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top"
                   Text="Rename this local branch. Its push target stays with it."
                   FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

        <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,20,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Classes="accent" Content="Rename" Command="{Binding ConfirmCommand}" />
            </StackPanel>
        </StackPanel>

        <Grid ColumnDefinitions="110,*" RowDefinitions="Auto,Auto" RowSpacing="10">
            <TextBlock Text="Branch:" Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding CurrentName}" FontWeight="SemiBold"
                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />

            <TextBlock Grid.Row="1" Text="New name:" Foreground="{DynamicResource MutedBrush}"
                       VerticalAlignment="Center" />
            <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1"
                     Text="{Binding NewName, Mode=TwoWay}"
                     HorizontalAlignment="Stretch" />
        </Grid>
    </DockPanel>
</Window>
