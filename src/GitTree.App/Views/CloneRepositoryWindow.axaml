<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitTree.App.ViewModels"
        x:Class="GitTree.App.Views.CloneRepositoryWindow"
        x:DataType="vm:CloneRepositoryViewModel"
        Title="Clone repository"
        Width="560"
        SizeToContent="Height"
        MinWidth="460"
        WindowStartupLocation="CenterOwner"
        CanResize="False">

    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top"
                   Text="Clone a remote Git URL into a local folder, then open it."
                   FontSize="14" Margin="0,0,0,16" TextWrapping="Wrap" />

        <StackPanel DockPanel.Dock="Bottom" Spacing="10" Margin="0,20,0,0">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" />
            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Classes="ghost" Content="Cancel" Command="{Binding CancelCommand}" />
                <Button Classes="accent" Content="Clone" Command="{Binding CloneCommand}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="12">
            <StackPanel Spacing="6">
                <TextBlock Text="Remote URL" Foreground="{DynamicResource MutedBrush}" />
                <TextBox Text="{Binding Url, Mode=TwoWay}" PlaceholderText="https://github.com/owner/repo.git"
                         HorizontalAlignment="Stretch" />
            </StackPanel>
            <StackPanel Spacing="6">
                <TextBlock Text="Clone into" Foreground="{DynamicResource MutedBrush}" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <TextBox Text="{Binding Destination, Mode=TwoWay}" PlaceholderText="Local folder for the new clone"
                             HorizontalAlignment="Stretch" />
                    <Button Grid.Column="1" Classes="ghost" Content="Browse" Command="{Binding BrowseCommand}" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
