<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GitTree.App.ViewModels"
        xmlns:controls="using:GitTree.App.Controls"
        xmlns:conv="using:GitTree.App.Converters"
        xmlns:core="using:GitTree.Core"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="GitTree.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1440" Height="900"
        MinWidth="1040" MinHeight="680">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Classes="toolbar" Padding="14,10">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Width="28" Height="28" CornerRadius="8"
                            Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1">
                        <TextBlock Text="⌥" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentBrush}" FontWeight="Bold" />
                    </Border>
                    <TextBlock Classes="brand" Text="GitTree" VerticalAlignment="Center" />
                    <Border Width="1" Height="22" Background="{DynamicResource LineBrush}" Margin="6,0" />
                    <Button Classes="accent" Content="Open repository" Command="{Binding OpenRepositoryCommand}" />
                    <ComboBox Width="280" ItemsSource="{Binding RecentRepositories}"
                              SelectedItem="{Binding SelectedRecent}"
                              PlaceholderText="Jump to a recent repo">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:RecentRepoItem">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Branch}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Border CornerRadius="999" Padding="10,5" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentSoftBrush}" BorderThickness="1"
                            IsVisible="{Binding HasRepo}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding CurrentBranch}" FontWeight="SemiBold" FontSize="12.5" />
                            <Border CornerRadius="999" Padding="7,1" Background="#28F5C542" IsVisible="{Binding HasAhead}"
                                    ToolTip.Tip="Local commits not on the remote. Push to publish them.">
                                <TextBlock Text="{Binding AheadBadge}" FontSize="11" Foreground="#F5C542" FontWeight="SemiBold" />
                            </Border>
                            <Border CornerRadius="999" Padding="7,1" Background="#285B8DEF" IsVisible="{Binding HasBehind}"
                                    ToolTip.Tip="Remote commits you do not have yet. Pull to update.">
                                <TextBlock Text="{Binding BehindBadge}" FontSize="11" Foreground="#9BB4FF" FontWeight="SemiBold" />
                            </Border>
                            <TextBlock Text="in sync" FontSize="11" Foreground="#8FF5C6" IsVisible="{Binding IsInSync}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="no upstream" FontSize="11" Foreground="#8B95A8" IsVisible="{Binding HasNoUpstream}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Classes="ghost" Content="Refresh" Command="{Binding RefreshCommand}"
                            IsEnabled="{Binding HasRepo}" IsVisible="{Binding !NeedsRefresh}"
                            ToolTip.Tip="Reload status, branches, and graph" />
                    <Button Classes="warn" Command="{Binding RefreshCommand}"
                            IsVisible="{Binding NeedsRefresh}"
                            ToolTip.Tip="Files or refs changed on disk. Click to reload this branch.">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource WarningBrush}" />
                            <TextBlock Text="Refresh needed" FontWeight="SemiBold" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Content="Settings" Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="Themes and window position" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Button Classes="ghost" Command="{Binding FetchCommand}" IsEnabled="{Binding HasRepo}"
                            ToolTip.Tip="Download remote commits without merging">
                        <TextBlock Text="Fetch" />
                    </Button>
                    <Button Classes="ghost" Command="{Binding PullCommand}" IsEnabled="{Binding HasRepo}"
                            ToolTip.Tip="Bring remote commits into this branch">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Pull" VerticalAlignment="Center" />
                            <Border CornerRadius="999" Padding="6,1" Background="#285B8DEF" IsVisible="{Binding HasBehind}">
                                <TextBlock Text="{Binding BehindCount}" FontSize="11" Foreground="#9BB4FF" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Button Classes="ghost" Command="{Binding PushCommand}" IsEnabled="{Binding HasRepo}"
                            ToolTip.Tip="Publish local commits to the remote">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Push" VerticalAlignment="Center" />
                            <Border CornerRadius="999" Padding="6,1" Background="#28F5C542" IsVisible="{Binding HasAhead}">
                                <TextBlock Text="{Binding AheadCount}" FontSize="11" Foreground="#F5C542" />
                            </Border>
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="18" Background="#2A354C" Margin="4,0" />
                    <Button Classes="ghost" Content="Merge" Command="{Binding MergeSelectedCommand}" IsEnabled="{Binding HasRepo}" />
                    <Button Classes="ghost" Content="Rebase" Command="{Binding RebaseSelectedCommand}" IsEnabled="{Binding HasRepo}" />
                    <Button Classes="ghost" Content="Stash" Command="{Binding StashSaveCommand}" IsEnabled="{Binding HasRepo}" />
                    <Border Width="1" Height="18" Background="#2A354C" Margin="4,0" />
                    <TextBox Width="168" PlaceholderText="New branch name" Text="{Binding NewBranchName}" />
                    <Button Classes="ghost" Content="Create branch" Command="{Binding CreateBranchCommand}" IsEnabled="{Binding HasRepo}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid x:Name="WorkspaceGrid" ColumnDefinitions="268,8,*" Margin="12" IsVisible="{Binding HasRepo}">
                <Border Classes="pane">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="10,8">
                            <Expander Classes="sidebar" IsExpanded="True">
                                <Expander.Header>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="999" Padding="7,1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding LocalCount}" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <TextBlock Classes="section" Text="LOCAL" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <TreeView x:Name="LocalBranchesTree"
                                              ItemsSource="{Binding LocalTree}"
                                              SelectedItem="{Binding SelectedLocalNode, Mode=TwoWay}"
                                              ContextRequested="OnLocalTreeContextRequested">
                                        <TreeView.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Checkout" Command="{Binding CheckoutLocalCommand}" />
                                                <MenuItem Header="Delete branch" Command="{Binding DeleteLocalBranchCommand}" />
                                            </ContextMenu>
                                        </TreeView.ContextMenu>
                                        <TreeView.ItemTemplate>
                                            <TreeDataTemplate x:DataType="vm:RefTreeNode" ItemsSource="{Binding Children}">
                                                <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                    <Panel Width="16" Margin="0,0,6,0" VerticalAlignment="Center">
                                                        <TextBlock Text="▸" Foreground="{DynamicResource MutedBrush}" IsVisible="{Binding IsFolder}" />
                                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Center"
                                                                 IsVisible="{Binding IsCurrent}" />
                                                        <Ellipse Width="7" Height="7" Fill="{DynamicResource LineBrush}" HorizontalAlignment="Center"
                                                                 IsVisible="{Binding IsInactiveBranch}" />
                                                    </Panel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding SyncBadge}" FontSize="10"
                                                               Foreground="{DynamicResource WarningBrush}" VerticalAlignment="Center" Margin="6,0,0,0"
                                                               IsVisible="{Binding HasSyncBadge}" />
                                                    <Border Grid.Column="3" Background="{DynamicResource AccentSoftBrush}" CornerRadius="999" Padding="6,1"
                                                            IsVisible="{Binding IsCurrent}">
                                                        <TextBlock Text="HEAD" FontSize="10" Foreground="{DynamicResource AccentBrush}" />
                                                    </Border>
                                                </Grid>
                                            </TreeDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,8,0,4">
                                        <Button Classes="ghost tiny" Content="Checkout" Command="{Binding CheckoutLocalCommand}" />
                                        <Button Classes="danger tiny" Content="Delete" Command="{Binding DeleteLocalBranchCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <Expander Classes="sidebar" IsExpanded="True">
                                <Expander.Header>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource InfoSubtleBrush}" CornerRadius="999" Padding="7,1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding RemoteCount}" FontSize="11" Foreground="{DynamicResource InfoBrush}" />
                                        </Border>
                                        <TextBlock Classes="section" Text="REMOTES" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <TreeView ItemsSource="{Binding RemoteTree}" SelectedItem="{Binding SelectedRemoteNode, Mode=TwoWay}">
                                        <TreeView.ItemTemplate>
                                            <TreeDataTemplate x:DataType="vm:RefTreeNode" ItemsSource="{Binding Children}">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="▸" Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0" IsVisible="{Binding IsFolder}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource InfoBrush}" />
                                                </Grid>
                                            </TreeDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                    <Button Classes="ghost tiny" Content="Checkout as local" Command="{Binding CheckoutRemoteCommand}"
                                            HorizontalAlignment="Left" Margin="4,8,0,4" />
                                </StackPanel>
                            </Expander>

                            <Expander Classes="sidebar" IsExpanded="False">
                                <Expander.Header>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource WarningSubtleBrush}" CornerRadius="999" Padding="7,1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding TagCount}" FontSize="11" Foreground="{DynamicResource WarningBrush}" />
                                        </Border>
                                        <TextBlock Classes="section" Text="TAGS" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <TreeView ItemsSource="{Binding TagTree}" SelectedItem="{Binding SelectedTagNode, Mode=TwoWay}">
                                        <TreeView.ItemTemplate>
                                            <TreeDataTemplate x:DataType="vm:RefTreeNode" ItemsSource="{Binding Children}">
                                                <Grid ColumnDefinitions="Auto,*">
                                                    <TextBlock Text="▸" Foreground="{DynamicResource MutedBrush}" Margin="0,0,6,0" IsVisible="{Binding IsFolder}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Label}" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource WarningBrush}" />
                                                </Grid>
                                            </TreeDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                    <Button Classes="ghost tiny" Content="Checkout tag" Command="{Binding CheckoutTagCommand}"
                                            HorizontalAlignment="Left" Margin="4,8,0,4" />
                                </StackPanel>
                            </Expander>

                            <Expander Classes="sidebar" IsExpanded="False">
                                <Expander.Header>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource OverlayBrush}" CornerRadius="999" Padding="7,1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding StashCount}" FontSize="11" Foreground="{DynamicResource MutedBrush}" />
                                        </Border>
                                        <TextBlock Classes="section" Text="STASHES" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <TreeView ItemsSource="{Binding StashTree}" SelectedItem="{Binding SelectedStashNode, Mode=TwoWay}">
                                        <TreeView.ItemTemplate>
                                            <TreeDataTemplate x:DataType="vm:RefTreeNode" ItemsSource="{Binding Children}">
                                                <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Opacity="0.92" />
                                            </TreeDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,8,0,4">
                                        <Button Classes="ghost tiny" Content="Apply" Command="{Binding StashApplyCommand}" />
                                        <Button Classes="danger tiny" Content="Drop" Command="{Binding StashDropCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>

                            <Expander Classes="sidebar" IsExpanded="True">
                                <Expander.Header>
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="999" Padding="7,1" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding WorktreeCount}" FontSize="11" Foreground="{DynamicResource AccentHoverBrush}" />
                                        </Border>
                                        <TextBlock Classes="section" Text="WORKTREES" Margin="0" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Expander.Header>
                                <StackPanel>
                                    <TreeView x:Name="WorktreesTree"
                                              ItemsSource="{Binding WorktreeTree}"
                                              SelectedItem="{Binding SelectedWorktreeNode, Mode=TwoWay}"
                                              ContextRequested="OnWorktreeTreeContextRequested">
                                        <TreeView.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="Switch to worktree" Command="{Binding SwitchWorktreeCommand}" />
                                                <MenuItem Header="Get changes" Command="{Binding ImportWorktreeChangesCommand}" />
                                                <Separator />
                                                <MenuItem Header="Delete worktree" Command="{Binding RemoveWorktreeCommand}" />
                                            </ContextMenu>
                                        </TreeView.ContextMenu>
                                        <TreeView.ItemTemplate>
                                            <TreeDataTemplate x:DataType="vm:RefTreeNode" ItemsSource="{Binding Children}">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource AccentHoverBrush}" />
                                                    <Border Grid.Column="1" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="999" Padding="6,1"
                                                            IsVisible="{Binding IsCurrent}">
                                                        <TextBlock Text="HERE" FontSize="10" Foreground="{DynamicResource AccentHoverBrush}" />
                                                    </Border>
                                                </Grid>
                                            </TreeDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>
                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="4,8,0,4">
                                        <Button Classes="ghost tiny" Content="Switch" Command="{Binding SwitchWorktreeCommand}" />
                                        <Button Classes="accent tiny" Content="Get changes" Command="{Binding ImportWorktreeChangesCommand}" />
                                    </StackPanel>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <GridSplitter Grid.Column="1" />

                <Grid x:Name="GraphFilesGrid" Grid.Column="2" RowDefinitions="*,8,236">
                    <Grid x:Name="GraphDiffGrid">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*" MinWidth="280" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" MinWidth="260" />
                        </Grid.ColumnDefinitions>
                    <Border Classes="pane">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                        <Button Classes="ghost tiny" Content="Working tree"
                                                Command="{Binding ShowWorkingTreeCommand}" />
                                        <Button Classes="ghost tiny" Content="Checkout commit"
                                                Command="{Binding CheckoutCommitCommand}" />
                                    </StackPanel>
                                    <TextBlock Classes="section" Text="GRAPH" Margin="0" VerticalAlignment="Center" />
                                </DockPanel>
                            </Border>
                            <ListBox x:Name="CommitList" Classes="commits"
                                     ItemsSource="{Binding Commits}"
                                     SelectedItem="{Binding SelectedCommit}"
                                     AutoScrollToSelectedItem="True"
                                     Padding="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:CommitNode">
                                        <Grid ColumnDefinitions="Auto,76,*,140,118" Height="40" ClipToBounds="True">
                                            <controls:GraphRowControl Commit="{Binding}" VerticalAlignment="Stretch" />
                                            <TextBlock Grid.Column="1" Text="{Binding ShortSha}"
                                                       FontFamily="Cascadia Mono, Consolas, monospace"
                                                       Foreground="#8B9CFF" VerticalAlignment="Center" FontSize="12"
                                                       Margin="6,0,8,0" />
                                            <Grid Grid.Column="2" ClipToBounds="True" Margin="0,0,10,0"
                                                  ColumnDefinitions="Auto,*" VerticalAlignment="Center">
                                                <ItemsControl ItemsSource="{Binding Decorations}" Margin="0,0,8,0"
                                                              MaxWidth="240" ClipToBounds="True">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <StackPanel Orientation="Horizontal" Spacing="4" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border CornerRadius="999" Padding="7,2" MaxWidth="220" ClipToBounds="True"
                                                                    Background="{Binding Converter={x:Static conv:DecorationChipConverter.Background}}"
                                                                    BorderBrush="{Binding Converter={x:Static conv:DecorationChipConverter.Border}}"
                                                                    BorderThickness="1"
                                                                    ToolTip.Tip="{Binding}">
                                                                <controls:TruncatingTextBlock Text="{Binding}" FontSize="10"
                                                                           Foreground="{Binding Converter={x:Static conv:DecorationChipConverter.Foreground}}" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Grid.Column="1" Background="Transparent" ToolTip.Tip="{Binding Subject}">
                                                    <controls:TruncatingTextBlock Text="{Binding Subject}" FontSize="13.5"
                                                               VerticalAlignment="Center" />
                                                </Border>
                                            </Grid>
                                            <Border Grid.Column="3" Background="Transparent" ToolTip.Tip="{Binding AuthorName}">
                                                <controls:TruncatingTextBlock Text="{Binding AuthorName}"
                                                       VerticalAlignment="Center" Foreground="#8B95A8" FontSize="12"
                                                       Margin="0,0,8,0" />
                                            </Border>
                                            <Border Grid.Column="4" Background="Transparent"
                                                    ToolTip.Tip="{Binding AuthorDate, StringFormat='{}{0:MMM dd  HH:mm}'}">
                                                <controls:TruncatingTextBlock
                                                       Text="{Binding AuthorDate, StringFormat='{}{0:MMM dd  HH:mm}'}"
                                                       VerticalAlignment="Center" Foreground="#667084" FontSize="12"
                                                       HorizontalAlignment="Right" Margin="0,0,12,0" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <GridSplitter Grid.Column="1" />

                    <Grid Grid.Column="2" RowDefinitions="Auto,*">
                    <Border Classes="pane" Margin="0,0,0,8" Padding="12" IsVisible="{Binding HasConflictOperation}">
                        <StackPanel Spacing="10">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Border Width="8" Height="8" CornerRadius="4" Background="#FF5C7A" />
                                <TextBlock Text="Conflicts need your attention" FontWeight="SemiBold" />
                                <Border Background="#33FF5C7A" CornerRadius="999" Padding="7,1">
                                    <TextBlock Text="{Binding ConflictCount}" FontSize="11" Foreground="#FF5C7A" />
                                </Border>
                            </StackPanel>
                            <WrapPanel>
                                <Button Classes="accent tiny" Content="Continue merge" Command="{Binding ContinueMergeCommand}"
                                        IsVisible="{Binding IsMerging}" Margin="0,0,6,6" />
                                <Button Classes="danger tiny" Content="Abort merge" Command="{Binding AbortMergeCommand}"
                                        IsVisible="{Binding IsMerging}" Margin="0,0,6,6" />
                                <Button Classes="accent tiny" Content="Continue rebase" Command="{Binding ContinueRebaseCommand}"
                                        IsVisible="{Binding IsRebasing}" Margin="0,0,6,6" />
                                <Button Classes="danger tiny" Content="Abort rebase" Command="{Binding AbortRebaseCommand}"
                                        IsVisible="{Binding IsRebasing}" Margin="0,0,6,6" />
                            </WrapPanel>
                            <ListBox MinHeight="96" MaxHeight="180" ItemsSource="{Binding Conflicts}" SelectedItem="{Binding SelectedConflict}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:FileChange">
                                        <Border Background="#FF5C7A" CornerRadius="6" Padding="8,6">
                                            <TextBlock Text="{Binding DisplayPath}" Foreground="#14080C" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayPath}" />
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Button Classes="ghost tiny" Content="Take ours" Command="{Binding TakeOursCommand}" />
                                <Button Classes="ghost tiny" Content="Take theirs" Command="{Binding TakeTheirsCommand}" />
                                <Button Classes="accent tiny" Content="Mark resolved" Command="{Binding MarkResolvedCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Classes="pane">
                        <DockPanel>
                            <Border DockPanel.Dock="Top" Padding="14,10" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource DiffRemovedBgBrush}" BorderBrush="{DynamicResource DangerBrush}" BorderThickness="1" />
                                            <TextBlock Text="removed" FontSize="11" Foreground="{DynamicResource DangerBrush}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource DiffAddedBgBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" />
                                            <TextBlock Text="added" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                                        </StackPanel>
                                    </StackPanel>
                                    <TextBlock Text="{Binding DiffHeader}" FontSize="12.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                                </DockPanel>
                            </Border>
                            <Button DockPanel.Dock="Bottom" Classes="ghost" Content="Save conflict edits"
                                    Command="{Binding SaveConflictFileCommand}" IsVisible="{Binding ShowConflictEditor}" Margin="10" />
                            <TextBox IsVisible="{Binding ShowConflictEditor}"
                                     Text="{Binding ConflictFileText}"
                                     AcceptsReturn="True"
                                     FontFamily="Cascadia Mono, Consolas, monospace"
                                     FontSize="12.5"
                                     TextWrapping="NoWrap"
                                     BorderThickness="0"
                                     CornerRadius="0" />
                            <ListBox Classes="diff" IsVisible="{Binding !ShowConflictEditor}" ItemsSource="{Binding DiffLines}"
                                     Background="{DynamicResource DiffBgBrush}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="core:DiffLine">
                                        <controls:DiffLineView Line="{Binding}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    </Grid>
                    </Grid>

                    <GridSplitter Grid.Row="1" />

                    <Grid Grid.Row="2">
                        <Grid ColumnDefinitions="*,8,*,8,220" IsVisible="{Binding !IsShowingCommitFiles}">
                            <Border Classes="pane">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                                <Button Classes="ghost tiny" Content="Stage" Command="{Binding StageCommand}"
                                                        ToolTip.Tip="Stage selected files. Ctrl+click or Shift+click to select several." />
                                                <Button Classes="ghost tiny" Content="All" Click="OnSelectAllUnstaged"
                                                        ToolTip.Tip="Select every unstaged file" />
                                                <Button Classes="danger tiny" Content="Discard" Command="{Binding DiscardCommand}" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="section" Text="UNSTAGED" Margin="0" VerticalAlignment="Center" />
                                                <Border Background="#22C9A227" CornerRadius="999" Padding="7,1">
                                                    <TextBlock Text="{Binding UnstagedCount}" FontSize="11" Foreground="#F5C542" />
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <ListBox x:Name="UnstagedList" Classes="files" ItemsSource="{Binding Unstaged}"
                                             SelectedItem="{Binding SelectedUnstaged}"
                                             SelectionMode="Multiple"
                                             SelectionChanged="OnUnstagedSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="core:FileChange">
                                                <Border CornerRadius="6" Padding="6,5"
                                                        Background="{Binding IsConflict, Converter={x:Static conv:ConflictRowBrushConverter.Instance}}">
                                                <Grid ColumnDefinitions="Auto,*" ClipToBounds="True">
                                                    <Border Width="20" Height="20" CornerRadius="5" Margin="0,0,8,0"
                                                            Background="{Binding BadgeChar, Converter={x:Static conv:FileBadgeBrushConverter.Instance}, ConverterParameter=bg}"
                                                            BorderBrush="{Binding BadgeChar, Converter={x:Static conv:FileBadgeBrushConverter.Instance}, ConverterParameter=fg}"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{Binding BadgeChar}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{Binding BadgeChar, Converter={x:Static conv:FileBadgeBrushConverter.Instance}, ConverterParameter=fg}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Grid.Column="1" Background="Transparent" ToolTip.Tip="{Binding DisplayPath}">
                                                    <controls:TruncatingTextBlock Text="{Binding DisplayPath}" VerticalAlignment="Center"
                                                               Foreground="{Binding Converter={x:Static conv:ConflictTextBrushConverter.Instance}}" />
                                                    </Border>
                                                </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <GridSplitter Grid.Column="1" />

                            <Border Grid.Column="2" Classes="pane">
                                <DockPanel>
                                    <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
                                                <Button Classes="ghost tiny" Content="Unstage" Command="{Binding UnstageCommand}"
                                                        ToolTip.Tip="Unstage selected files. Ctrl+click or Shift+click to select several." />
                                                <Button Classes="ghost tiny" Content="All" Click="OnSelectAllStaged"
                                                        ToolTip.Tip="Select every staged file" />
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Classes="section" Text="STAGED" Margin="0" VerticalAlignment="Center" />
                                                <Border Background="#223DDC97" CornerRadius="999" Padding="7,1">
                                                    <TextBlock Text="{Binding StagedCount}" FontSize="11" Foreground="#3DDC97" />
                                                </Border>
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <ListBox x:Name="StagedList" Classes="files" ItemsSource="{Binding Staged}"
                                             SelectedItem="{Binding SelectedStaged}"
                                             SelectionMode="Multiple"
                                             SelectionChanged="OnStagedSelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="core:FileChange">
                                                <Grid ColumnDefinitions="Auto,*" ClipToBounds="True">
                                                    <Border Width="20" Height="20" CornerRadius="5" Margin="0,0,8,0"
                                                            Background="{Binding BadgeChar, Converter={x:Static conv:FileBadgeBrushConverter.Instance}, ConverterParameter=bg}"
                                                            BorderBrush="{Binding BadgeChar, Converter={x:Static conv:FileBadgeBrushConverter.Instance}, ConverterParameter=fg}"
                                                            BorderThickness="1">
                                                        <TextBlock Text="{Binding BadgeChar}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{Binding BadgeChar, Converter={x:Static conv:FileBadgeBrushConverter.Instance}, ConverterParameter=fg}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Grid.Column="1" Background="Transparent" ToolTip.Tip="{Binding DisplayPath}">
                                                    <controls:TruncatingTextBlock Text="{Binding DisplayPath}" VerticalAlignment="Center"
                                                               Foreground="{Binding BadgeChar, Converter={x:Static conv:FileBadgeBrushConverter.Instance}, ConverterParameter=path}" />
                                                    </Border>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <GridSplitter Grid.Column="3" />

                            <Border Grid.Column="4" Classes="pane" Padding="12">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Top" Classes="section" Text="COMMIT" Margin="0,0,0,8" />
                                    <Button DockPanel.Dock="Bottom" Classes="accent" Content="Commit"
                                            Command="{Binding CommitCommand}" HorizontalAlignment="Stretch" Margin="0,10,0,0" />
                                    <TextBlock DockPanel.Dock="Bottom" Text="Cannot commit until conflicts are resolved."
                                               Foreground="#FF5C7A" FontSize="12" TextWrapping="Wrap" Margin="0,8,0,0"
                                               IsVisible="{Binding HasConflicts}" />
                                    <TextBox AcceptsReturn="True" Text="{Binding CommitMessage}"
                                             PlaceholderText="Commit message" />
                                </DockPanel>
                            </Border>
                        </Grid>

                        <Border Classes="pane" IsVisible="{Binding IsShowingCommitFiles}">
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Padding="12,8" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="Auto,Auto,*" ClipToBounds="True">
                                        <TextBlock Classes="section" Text="CHANGED IN COMMIT" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedCommit.ShortSha}" FontFamily="Cascadia Mono, Consolas, monospace"
                                                   Foreground="#8B9CFF" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Border Grid.Column="2" Background="Transparent" ToolTip.Tip="{Binding SelectedCommit.Subject}">
                                            <controls:TruncatingTextBlock Text="{Binding SelectedCommit.Subject}"
                                                   Foreground="#8B95A8" VerticalAlignment="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <ListBox Classes="files" ItemsSource="{Binding CommitFiles}" SelectedItem="{Binding SelectedCommitFile}">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="core:FileChange">
                                            <Grid ColumnDefinitions="Auto,*" ClipToBounds="True">
                                                <Border Width="20" Height="20" CornerRadius="5" Margin="0,0,8,0"
                                                        Background="{Binding BadgeChar, Converter={x:Static conv:FileBadgeBrushConverter.Instance}, ConverterParameter=bg}"
                                                        BorderBrush="{Binding BadgeChar, Converter={x:Static conv:FileBadgeBrushConverter.Instance}, ConverterParameter=fg}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="{Binding BadgeChar}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding BadgeChar, Converter={x:Static conv:FileBadgeBrushConverter.Instance}, ConverterParameter=fg}"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <Border Grid.Column="1" Background="Transparent" ToolTip.Tip="{Binding DisplayPath}">
                                                <controls:TruncatingTextBlock Text="{Binding DisplayPath}" VerticalAlignment="Center"
                                                           Foreground="{Binding BadgeChar, Converter={x:Static conv:FileBadgeBrushConverter.Instance}, ConverterParameter=path}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Grid>

            <Grid RowDefinitions="Auto,*" IsVisible="{Binding !HasRepo}" Margin="28,20,28,16"
                  Background="{DynamicResource Bg0Brush}">
                <DockPanel Margin="0,0,0,18">
                    <Button Classes="accent" Content="Open a Git repository" Command="{Binding OpenRepositoryCommand}"
                            DockPanel.Dock="Right" Padding="18,10" VerticalAlignment="Center" />
                    <StackPanel Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="Latest repositories" FontSize="26" FontWeight="Bold" />
                        <TextBlock Text="Pick a recent repo to open it. Branch, last commit, and working-tree status sit next to each name."
                                   TextWrapping="Wrap" Foreground="{DynamicResource MutedBrush}" FontSize="14" />
                    </StackPanel>
                </DockPanel>

                <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding RecentRepositories}" IsVisible="{Binding HasRecents}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Vertical" Spacing="8" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RecentRepoItem">
                                    <Button Classes="ghost" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                            Padding="0" Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}">
                                        <Border Background="{DynamicResource Bg2Brush}" CornerRadius="10" Padding="14,12"
                                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1">
                                            <Grid ColumnDefinitions="220,*,160,110" ColumnSpacing="16">
                                                <StackPanel Spacing="2">
                                                    <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding ParentFolder}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}"
                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Path}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Spacing="2">
                                                    <TextBlock Text="{Binding LastCommit}" FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding LastCommit}" />
                                                    <TextBlock Text="{Binding LastCommitWhen}" FontSize="11.5" Foreground="{DynamicResource MutedBrush}" />
                                                </StackPanel>
                                                <Border Grid.Column="2" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="999" Padding="10,4"
                                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Branch}" FontSize="12" Foreground="{DynamicResource AccentBrush}"
                                                               FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="{Binding StatusLabel}" FontSize="12.5"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource WarningBrush}" />
                                            </Grid>
                                        </Border>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel IsVisible="{Binding !HasRecents}" HorizontalAlignment="Center" Margin="0,48,0,0" Spacing="10">
                            <TextBlock Text="No recent repositories yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="Open a Git folder and it will show up here next time."
                                       Foreground="{DynamicResource MutedBrush}" HorizontalAlignment="Center" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
            <ProgressBar VerticalAlignment="Top" Height="2" MinHeight="2"
                         IsIndeterminate="True" IsHitTestVisible="False"
                         IsVisible="{Binding IsBusy}" Opacity="0.95" />
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource Bg0Brush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,8">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource AccentBrush}" IsVisible="{Binding !HasError}" />
                    <Ellipse Width="8" Height="8" Fill="{DynamicResource DangerBrush}" IsVisible="{Binding HasError}" />
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource MutedBrush}" FontSize="12.5" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerBrush}" FontSize="12.5"
                           Margin="18,0" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="2" Text="{Binding RepoPath}" Foreground="{DynamicResource MutedBrush}" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</Window>
