<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GitTree.App.App"
             xmlns:local="using:GitTree.App"
             RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Styles/ScrollBars.axaml" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="Bg0">#2B303B</Color>
        <Color x:Key="Bg1">#323844</Color>
        <Color x:Key="Bg2">#3A4150</Color>
        <Color x:Key="Bg3">#434B5A</Color>
        <Color x:Key="Line">#4F5868</Color>
        <Color x:Key="Text">#D0D6E0</Color>
        <Color x:Key="Muted">#8E98A8</Color>
        <Color x:Key="Accent">#7EADC0</Color>
        <Color x:Key="AccentHover">#8EB8C8</Color>
        <Color x:Key="AccentBorder">#9AC0CE</Color>
        <Color x:Key="AccentOn">#2B303B</Color>
        <Color x:Key="AccentDim">#4E7380</Color>
        <Color x:Key="Danger">#B88890</Color>
        <Color x:Key="Warning">#C0B080</Color>
        <Color x:Key="Info">#7E98B0</Color>
        <Color x:Key="InputBg">#2E3440</Color>
        <Color x:Key="Toolbar">#E6323844</Color>
        <Color x:Key="Overlay">#0EFFFFFF</Color>
        <Color x:Key="AccentSubtle">#1A7EADC0</Color>
        <Color x:Key="AccentSoft">#337EADC0</Color>
        <Color x:Key="WarningSubtle">#28C0B080</Color>
        <Color x:Key="InfoSubtle">#287E98B0</Color>
        <Color x:Key="DangerSubtle">#33B88890</Color>
        <Color x:Key="DiffBg">#2E3440</Color>
        <Color x:Key="DiffAddedBg">#35484A</Color>
        <Color x:Key="DiffRemovedBg">#3E3844</Color>
        <Color x:Key="DiffHunkBg">#343A48</Color>
        <Color x:Key="DiffAddedFg">#C0D4D4</Color>
        <Color x:Key="DiffRemovedFg">#D0C4C8</Color>
        <Color x:Key="DiffAddedSpan">#3C5858</Color>
        <Color x:Key="DiffRemovedSpan">#4A3C48</Color>
        <SolidColorBrush x:Key="Bg0Brush" Color="{StaticResource Bg0}" />
        <SolidColorBrush x:Key="Bg1Brush" Color="{StaticResource Bg1}" />
        <SolidColorBrush x:Key="Bg2Brush" Color="{StaticResource Bg2}" />
        <SolidColorBrush x:Key="Bg3Brush" Color="{StaticResource Bg3}" />
        <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}" />
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource Text}" />
        <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}" />
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
        <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHover}" />
        <SolidColorBrush x:Key="AccentBorderBrush" Color="{StaticResource AccentBorder}" />
        <SolidColorBrush x:Key="AccentOnBrush" Color="{StaticResource AccentOn}" />
        <SolidColorBrush x:Key="AccentDimBrush" Color="{StaticResource AccentDim}" />
        <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
        <SolidColorBrush x:Key="WarningBrush" Color="{StaticResource Warning}" />
        <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource Info}" />
        <SolidColorBrush x:Key="InputBgBrush" Color="{StaticResource InputBg}" />
        <SolidColorBrush x:Key="ToolbarBrush" Color="{StaticResource Toolbar}" />
        <SolidColorBrush x:Key="OverlayBrush" Color="{StaticResource Overlay}" />
        <SolidColorBrush x:Key="AccentSubtleBrush" Color="{StaticResource AccentSubtle}" />
        <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoft}" />
        <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource WarningSubtle}" />
        <SolidColorBrush x:Key="InfoSubtleBrush" Color="{StaticResource InfoSubtle}" />
        <SolidColorBrush x:Key="DangerSubtleBrush" Color="{StaticResource DangerSubtle}" />
        <SolidColorBrush x:Key="DiffBgBrush" Color="{StaticResource DiffBg}" />
        <SolidColorBrush x:Key="DiffAddedBgBrush" Color="{StaticResource DiffAddedBg}" />
        <SolidColorBrush x:Key="DiffRemovedBgBrush" Color="{StaticResource DiffRemovedBg}" />
        <SolidColorBrush x:Key="DiffHunkBgBrush" Color="{StaticResource DiffHunkBg}" />
        <SolidColorBrush x:Key="DiffAddedFgBrush" Color="{StaticResource DiffAddedFg}" />
        <SolidColorBrush x:Key="DiffRemovedFgBrush" Color="{StaticResource DiffRemovedFg}" />
        <SolidColorBrush x:Key="DiffAddedSpanBrush" Color="{StaticResource DiffAddedSpan}" />
        <SolidColorBrush x:Key="DiffRemovedSpanBrush" Color="{StaticResource DiffRemovedSpan}" />
        <CornerRadius x:Key="R8">8</CornerRadius>
        <CornerRadius x:Key="R12">12</CornerRadius>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

        <Style Selector="Window">
            <Setter Property="FontFamily" Value="Inter, Segoe UI Variable, Segoe UI, sans-serif" />
            <Setter Property="Background" Value="{DynamicResource Bg0Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>

        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,2,2,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Opacity" Value="0.72" />
        </Style>

        <Style Selector="Border.count">
            <Setter Property="MinWidth" Value="22" />
            <Setter Property="MinHeight" Value="18" />
            <Setter Property="Padding" Value="7,0" />
            <Setter Property="CornerRadius" Value="999" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.count TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LineHeight" Value="14" />
        </Style>

        <Style Selector="TextBlock.brand">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="16" />
        </Style>

        <Style Selector="Border.pane">
            <Setter Property="Background" Value="{DynamicResource Bg1Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="Border.toolbar">
            <Setter Property="Background" Value="{DynamicResource ToolbarBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14" />
                </Transitions>
            </Setter>
        </Style>

        <Style Selector="Button.ghost">
            <Setter Property="Background" Value="{DynamicResource OverlayBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="11,7" />
            <Setter Property="FontSize" Value="12.5" />
        </Style>
        <Style Selector="Button.ghost:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="Button.ghost:disabled">
            <Setter Property="Opacity" Value="0.38" />
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource AccentOnBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.accent:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        </Style>
        <Style Selector="Button.accent:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <Style Selector="Button.warn">
            <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.warn:pointerover">
            <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}" />
        </Style>

        <Style Selector="Button.danger">
            <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="11,7" />
        </Style>
        <Style Selector="Button.danger:pointerover">
            <Setter Property="Background" Value="{DynamicResource DangerSubtleBrush}" />
        </Style>

        <Style Selector="Button.tiny">
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Margin" Value="2,1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover">
            <Setter Property="Background" Value="#14FFFFFF" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>

        <Style Selector="ListBox.diff ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="ListBox.diff ListBoxItem:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.diff ListBoxItem:selected">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.diff ListBoxItem:selected:pointerover">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBox.diff ListBoxItem Border.diff-sel-overlay">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
        </Style>
        <Style Selector="ListBox.diff ListBoxItem:selected Border.diff-sel-overlay">
            <Setter Property="Background" Value="#332A9BFF" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="ListBox.commits">
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.commits ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style Selector="ListBox.commits ListBoxItem:nth-child(even)">
            <Setter Property="Background" Value="#08FFFFFF" />
        </Style>
        <Style Selector="ListBox.commits ListBoxItem:pointerover">
            <Setter Property="Background" Value="#12FFFFFF" />
        </Style>
        <Style Selector="ListBox.commits ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
        </Style>
        <Style Selector="ListBox.files ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>

        <Style Selector="ToolTip">
            <Setter Property="Background" Value="{DynamicResource Bg2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="MaxWidth" Value="640" />
        </Style>
        <Style Selector="ToolTip TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
        </Style>
        <Style Selector="TextBox:focus">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        </Style>

        <Style Selector="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="MinHeight" Value="34" />
        </Style>

        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinWidth" Value="8" />
            <Setter Property="MinHeight" Value="8" />
        </Style>
        <Style Selector="GridSplitter:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>

        <Style Selector="ProgressBar">
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="MinHeight" Value="2" />
            <Setter Property="Height" Value="2" />
        </Style>

        <Style Selector="ScrollViewer">
            <Setter Property="AllowAutoHide" Value="False" />
        </Style>
        <Style Selector="ScrollBar">
            <Setter Property="AllowAutoHide" Value="False" />
            <Setter Property="Theme" Value="{StaticResource GitTreeScrollBarTheme}" />
        </Style>

        <Style Selector="Expander.sidebar">
            <Setter Property="Background" Value="{DynamicResource Bg1Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Expander.sidebar:pointerover">
            <Setter Property="Background" Value="{DynamicResource Bg1Brush}" />
        </Style>
        <Style Selector="Expander.sidebar /template/ ToggleButton">
            <Setter Property="Background" Value="{DynamicResource Bg2Brush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Expander.sidebar /template/ ToggleButton /template/ Border#ToggleButtonBackground">
            <Setter Property="Background" Value="{DynamicResource Bg2Brush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Expander.sidebar /template/ Border#ExpanderContent">
            <Setter Property="Background" Value="{DynamicResource Bg1Brush}" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Padding" Value="0,4,0,0" />
        </Style>
        <Style Selector="Expander.sidebar /template/ Path#ExpandCollapseChevron">
            <Setter Property="Fill" Value="{DynamicResource MutedBrush}" />
        </Style>

        <Style Selector="TreeView">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0,4,0,2" />
            <Setter Property="AutoScrollToSelectedItem" Value="False" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        </Style>
        <Style Selector="TreeViewItem">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="2,2" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="TreeViewItem:selected /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>

        <Style Selector="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource Bg2Brush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="6" />
        </Style>
        <Style Selector="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style Selector="MenuItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        </Style>
        <Style Selector="Separator">
            <Setter Property="Background" Value="{DynamicResource LineBrush}" />
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="6,4" />
        </Style>
    </Application.Styles>
</Application>
